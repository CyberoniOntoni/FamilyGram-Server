{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Sinks.Async" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console",
              "Args": {
                "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss:ffffff} [{Level:u3}] {Message}{NewLine}{Exception}"
              }
            }
          ]
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "mongodb://localhost:27017"
  },
  "App": {
    "DatabaseName": "tg",
    "ThisDcId": 1,
    "MediaDcId": 1
  },
  "Minio": {
    "Endpoint": "localhost:9000",
    "AccessKey": "test",
    "SecretKey": "test",
    "BucketName": "tg-files",
    "CreateBucketIfNotExists": true,
    "UseSsl": false
  },
  "RabbitMQ": {
    "Connections": {
      "Default": {
        "HostName": "localhost",
        "Port": 5672,
        "UserName": "test",
        "Password": "test"
      }
    },
    "EventBus": {
      "ClientName": "MyTelegramFileServerPublisher",
      "ExchangeName": "MyTelegramExchange"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Grpc": {
        "Url": "http://0.0.0.0:8080",
        "Protocols": "Http2"
      }
    }
  }
}
